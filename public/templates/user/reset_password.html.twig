<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MoodDic — Reset password</title>
  <style>
    :root { color-scheme: light; }
    body {
      margin: 0; min-height: 100vh; display: grid; place-items: center;
      font-family: "Segoe UI", system-ui, sans-serif;
      background: linear-gradient(160deg, #DDF4FF 0%, #F0F4F8 45%, #E5F8D0 100%);
      color: #3C3C3C;
    }
    .card {
      width: min(420px, 92vw); background: #fff; border: 2px solid #E5E5E5;
      border-radius: 24px; padding: 28px 24px; box-shadow: 0 12px 40px rgba(60,60,60,.12);
    }
    h1 { margin: 0 0 8px; font-size: 1.6rem; }
    p { margin: 0 0 16px; line-height: 1.45; color: #666; }
    label { display: block; font-weight: 700; margin: 12px 0 6px; }
    input {
      width: 100%; box-sizing: border-box; border: 2px solid #E5E5E5; border-radius: 14px;
      padding: 12px 14px; font-size: 1rem;
    }
    button {
      margin-top: 18px; width: 100%; border: 0; border-radius: 14px; padding: 14px;
      background: #58CC02; color: #fff; font-weight: 800; font-size: 1rem; cursor: pointer;
    }
    .ok { color: #46A302; font-weight: 700; }
    .err { color: #FF4B4B; font-weight: 700; }
    .brand { color: #58CC02; font-weight: 800; letter-spacing: -0.02em; }
  </style>
</head>
<body>
  <main class="card">
    <div class="brand">MoodDic</div>
    <h1>Reset password</h1>
    {% if success %}
      <p class="ok">{{ message|default('Password updated. You can log in with the new password.') }}</p>
    {% elseif error %}
      <p class="err">{{ error }}</p>
    {% else %}
      <p>Choose a new password for your account.</p>
      <form method="post" action="{{ path('user.reset_password_page', {token: token}) }}">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" minlength="6" required autocomplete="new-password">
        <label for="repeatPassword">Confirm password</label>
        <input id="repeatPassword" name="repeatPassword" type="password" minlength="6" required autocomplete="new-password">
        <button type="submit">Save new password</button>
      </form>
    {% endif %}
  </main>
</body>
</html>
