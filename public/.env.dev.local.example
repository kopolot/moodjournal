# Copy to .env.dev.local when using Docker Compose
DATABASE_URL="postgresql://symfony:password@db/symfony?serverVersion=15&charset=utf8"
REDIS_URL=redis://redis:6379
MAILER_DSN=smtp://mailhog:1025
MESSENGER_TRANSPORT_DSN=amqp://user:password@rabbitmq:5672/%2f/messages
APP_URL=http://localhost:8080

# Optional local LLM via compose profile `llm`:
#   UID=$(id -u) docker compose --profile llm up -d
# Uncomment after Ollama is up (requires a strong GPU for comfort):
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1:8b
# # or: OPENAI_MODEL=qwen2.5:7b
# # override pull target: OLLAMA_MODEL=qwen2.5:7b docker compose --profile llm up -d
